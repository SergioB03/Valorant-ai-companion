ANTHROPIC_API_KEY=your-anthropic-api-key-here
# HenrikDev Valorant API key (https://docs.henrikdev.xyz). Not a Riot key --
# the official Riot API path was dropped. RIOT_API_KEY is still read as a
# fallback so existing deployments keep working; prefer this name.
HENRIK_API_KEY=your-henrikdev-api-key-here
CLAUDE_MODEL=claude-opus-4-8
CORS_ORIGINS=http://localhost:5173
# Admin token for GET /analytics/summary — leave empty to disable /analytics/summary
ADMIN_TOKEN=
# Discord webhook for backend error alerts — leave empty to disable alerting
DISCORD_WEBHOOK_URL=
# Deployment-only (docker-compose.yml sets these) — leave unset for local dev
# ROOT_PATH=/api
# VAC_STATE_DIR=/app/state
# Seconds to wait for a Claude response before failing the request (default 50)
# CLAUDE_TIMEOUT_SECONDS=50

# Hard daily ceiling on Anthropic spend, in USD. Once the day's estimated
# spend crosses this, Claude-backed endpoints return 503 until UTC midnight.
# Set 0 to disable. Also set a limit in the Anthropic console — that one no
# bug in this code can defeat.
DAILY_BUDGET_USD=5.00
# Analytics table bounds (unauthenticated ingest, so it must not grow forever)
# ANALYTICS_RETENTION_DAYS=90
# ANALYTICS_MAX_ROWS=500000
# Per-source share of the daily budget, so one visitor cannot spend everyone's.
# Normal use is a handful of actions per visit. 0 disables.
FREE_AI_ACTIONS_PER_IP_PER_DAY=40

# DynamoDB table holding the daily spend total and each source's share.
#
# Blank (the default) keeps those counters in SQLite on this instance, which is
# correct for exactly one instance. Set it -- infra/bootstrap.sh creates the
# table -- before running a second one: otherwise each instance keeps its own
# total, so DAILY_BUDGET_USD multiplies by the instance count, and a deploy onto
# fresh storage resets the day's spend to zero.
#
# Switching stores starts today's total from zero once.
BUDGET_TABLE_NAME=
