# Production edge on the EC2 box: static frontend + same-origin API proxy.
# TLS is terminated by CloudFront in front of this, so only HTTP is spoken here.
:80 {
	encode zstd gzip

	# `route` keeps these in the written order (plain `handle` blocks get re-sorted).
	route {
		# Only accept requests carrying the shared secret our CloudFront distribution
		# stamps on origin requests (X-Origin-Verify). Otherwise anyone who learns the
		# origin hostname could point their own distribution at this box and bypass
		# CloudFront — and the per-IP rate limiting that relies on it. An unset
		# ORIGIN_SECRET (local dev) disables the check.
		@untrusted expression `{env.ORIGIN_SECRET} != "" && {header.X-Origin-Verify} != {env.ORIGIN_SECRET}`
		respond @untrusted 403

		# /api/<path>  ->  backend /<path>   (prefix is stripped)
		handle_path /api/* {
			reverse_proxy api:8000
		}

		# Vite fingerprints everything under /assets, so those can be cached forever.
		# A miss here is a real 404 — never index.html with an immutable header.
		handle /assets/* {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Everything else is the SPA; index.html must always be revalidated so a
		# deploy shows up immediately.
		handle {
			root * /srv
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
