ANTHROPIC_API_KEY=your-anthropic-api-key-here
RIOT_API_KEY=your-riot-api-key-here
CLAUDE_MODEL=claude-opus-4-8
CORS_ORIGINS=http://localhost:5173
# Admin token for GET /analytics/summary — leave empty to disable /analytics/summary
ADMIN_TOKEN=
# Discord webhook for backend error alerts — leave empty to disable alerting
DISCORD_WEBHOOK_URL=
# Deployment-only (docker-compose.yml sets these) — leave unset for local dev
# ROOT_PATH=/api
# VAC_STATE_DIR=/app/state
# Seconds to wait for a Claude response before failing the request (default 50)
# CLAUDE_TIMEOUT_SECONDS=50
